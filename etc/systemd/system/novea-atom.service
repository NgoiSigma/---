[Unit]
Description=Novea Atom Real-Time Dispatcher Core for NikolaevElectrotrans
After=network.target target-stream.device
Wants=network-online.target
Documentation=https://github.com/NgoiSigma/Harmony-Development/tree/main

[Service]
Type=simple
WorkingDirectory=/opt/novea_atom
ExecStart=/opt/novea_atom/bin/NoveaAtomBoard
Restart=always
RestartSec=3s

# Настройка планировщика реального времени (RT-Preempt Linux)
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=85
CPUAffinity=1-3

# Изоляция ресурсов и ограничение утечек памяти
CapabilityBoundingSet=CAP_SYS_NICE CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/novea_atom/storage /var/log
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=novea-atom

[Install]
WantedBy=multi-user.target
